{
  "name": "textlog",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "DEV_RELOAD=true bun --watch src/server.tsx",
    "start": "PORT=3003 bun src/server.tsx",
    "seed": "bun src/seed.ts",
    "db:backup": "bun scripts/backup-database.ts",
    "db:restore": "bun scripts/restore-database.ts",
    "db:verify": "bun scripts/verify-database.ts",
    "db:load-test": "bun scripts/load-database.ts",
    "archive:public": "bun scripts/archive-public-data.ts",
    "stress:routes": "bun scripts/stress-routes.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "canvas": "^3.2.3",
    "hono": "^4.13.0",
    "jszip": "^3.10.1",
    "linkify-it": "^6.1.0",
    "react": "latest",
    "react-dom": "latest",
    "tlds": "^1.261.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "latest"
  }
}
