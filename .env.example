# `bun run start` defaults to production and validates these values before opening the database.
NODE_ENV=production
APP_URL=https://textlog.cc
HOST=0.0.0.0
PORT=3000

RESEND_API_KEY=
EMAIL_FROM="textlog <hello@textlog.cc>"
# Development only: send real transactional emails through Resend (default: false).
DEV_RESEND_EMAILS=false

# Required unless MODERATION_DISABLED=true is an intentional temporary production decision.
OPENAI_API_KEY=
MODERATION_DISABLED=false

# Web Push contact URI and VAPID key pair (generate with: bunx web-push generate-vapid-keys).
VAPID_SUBJECT=mailto:hello@textlog.cc
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Enable only behind a trusted proxy that overwrites forwarded client-address headers.
TRUST_PROXY=false

# At least 32 random characters, used for keyed daily-rotating IP pseudonyms.
IP_PSEUDONYM_SECRET=

DATABASE_PATH=storage/textlog.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000
DATABASE_BACKUP_DIR=storage/backups
DATABASE_BACKUP_RETENTION_DAYS=14
# Public, anonymized daily archive served at /dump.zip.
PUBLIC_ARCHIVE_PATH=public/dump.zip
# Optional incident-management webhook for automated backup and restore-drill failures.
BACKUP_ALERT_WEBHOOK_URL=
