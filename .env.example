# `bun run start` defaults to production and validates these values before opening the database.
NODE_ENV=development
APP_NAME=textlog
APP_URL=https://textlog.cc
HOST=0.0.0.0
PORT=3000

# Transactional email provider: resend, sendgrid, or google.
EMAIL_PROVIDER=resend
EMAIL_FROM="textlog <hello@textlog.cc>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# Google SMTP requires 2-Step Verification and an app password.
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=

# Development only: send real transactional emails (default: false).
DEV_SEND_EMAILS=false

OPENROUTER_API_KEY=
# Optional model overrides for AI hashtag suggestions. The paid model is retried only when the free model returns 429.
OPENROUTER_FREE_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_PAID_MODEL=google/gemma-4-26b-a4b-it

# Required unless MODERATION_DISABLED=true is an intentional temporary production decision.
OPENAI_API_KEY=

MODERATION_DISABLED=false
# Optional comma-separated local score thresholds. Unlisted categories keep OpenAI's positive/negative decision.
# Example: violence=0.95,violence/graphic=0.8
MODERATION_CATEGORY_THRESHOLDS=

# Required in production for #exec notes. Example: https://piston.example.com
PISTON_URL=

# Always require an SVG CAPTCHA on password login. When false, it is enabled automatically during attack bursts.
ENABLE_CAPTCHA_ALWAYS=false

# Web Push contact URI and VAPID key pair (generate with: bunx web-push generate-vapid-keys).
VAPID_SUBJECT=mailto:hello@textlog.cc
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Enable only behind a trusted proxy that overwrites forwarded client-address headers.
TRUST_PROXY=false
# Include the request User-Agent in HTTP access logs.
LOG_USER_AGENT=true
# Include anonymous requests in HTTP access logs.
LOG_ANONYMOUS=true
# Include Reddit campaign requests even when anonymous request logging is disabled.
LOG_CAMPAIGN=false

# At least 32 random characters, used for keyed daily-rotating IP pseudonyms.
IP_PSEUDONYM_SECRET=

DATABASE_PATH=storage/textlog.sqlite
DATABASE_BUSY_TIMEOUT_MS=5000
DATABASE_BACKUP_DIR=storage/backups
DATABASE_BACKUP_RETENTION_DAYS=14

# Log the slowest SQL statements while building All and My Feed pages. Bind values are never logged. Enabling this
# also enables materialized feed caching under `bun run dev`, so warm requests can be distinguished from cold builds.
FEED_QUERY_METRICS=false
FEED_QUERY_METRICS_MIN_MS=1
FEED_QUERY_METRICS_LIMIT=10

# Public, anonymized daily archive served at /dump.zip.
PUBLIC_ARCHIVE_PATH=public/dump.zip

# Optional incident-management webhook for automated backup and restore-drill failures.
BACKUP_ALERT_WEBHOOK_URL=

# Cloudflare R2 bucket for storing remote Open Graph images in production.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

GOOGLE_TRANSLATE_API_KEY=

MAPTILER_API_KEY=
